{
  "name": "vue3-persian-datetime-picker",
  "description": "A vue plugin to select jalali date and time",
  "version": "2.0.0",
  "author": "Mohammad Talkhabi",
  "license": "MIT",
  "type": "module",
  "main": "dist/vue3-persian-datetime-picker.umd.js",
  "module": "dist/vue3-persian-datetime-picker.es.js",
  "exports": {
    ".": {
      "import": "./dist/vue3-persian-datetime-picker.es.js",
      "require": "./dist/vue3-persian-datetime-picker.umd.js"
    }
  },
  "keywords": [
    "vuejs",
    "persian",
    "jalali",
    "datepicker",
    "timepicker",
    "datetime picker",
    "vue datepicker",
    "vue3 datepicker",
    "persian datepicker",
    "jalali datepicker",
    "shamsi datepicker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/talkhabi/vue3-persian-datetime-picker"
  },
  "files": [
    "src",
    "dist/*.js",
    "index.d.ts"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:lib": "vite build --config vite.lib.config.js"
  },
  "dependencies": {
    "moment": "^2.30.1",
    "moment-jalaali": "^0.10.5",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "sass": "^1.104.0",
    "vite": "^8.2.2",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  }
}
